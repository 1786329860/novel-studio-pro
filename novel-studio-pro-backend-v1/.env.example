# Novel Studio Pro 本地后端配置
# 复制为 .env 后填写。注意：不要把真实 API Key 上传到公开仓库。

# ---------------------------------------------------------------------------
# 基础配置
# ---------------------------------------------------------------------------
# 后端监听地址，部署时改为 0.0.0.0 以允许外部访问
APP_HOST=0.0.0.0
# 后端监听端口
APP_PORT=8765
# 数据存储目录
DATA_DIR=./data

# ---------------------------------------------------------------------------
# 部署配置
# ---------------------------------------------------------------------------
# CORS 允许的来源域名，逗号分隔。开发时可用 "*" 允许所有来源。
# 生产环境建议填写具体域名，如 "https://yourdomain.com,https://www.yourdomain.com"
CORS_ORIGINS=*
# 前端静态文件目录（相对于后端根目录的路径）
STATIC_DIR=../novel-studio-pro-frontend-v3
# 调试模式：开启后 uvicorn 启用热重载，仅用于开发环境
DEBUG=false

# ---------------------------------------------------------------------------
# DeepSeek AI 配置
# ---------------------------------------------------------------------------
# 默认 false：使用本地 Mock 自动化流程，不真实请求 DeepSeek。
USE_DEEPSEEK=false

# 预留 DeepSeek API 配置。正式接入时再填写。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAIN_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# 请求控制
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=180
RETRY_TIMES=2
MAX_INPUT_TOKENS=64000
MAX_OUTPUT_TOKENS=12000
