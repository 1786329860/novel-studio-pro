{
  "name": "novel-studio-pro-frontend-v3",
  "version": "0.3.0",
  "description": "Novel Studio Pro desktop frontend v3 with complete UI pages for characters, truth, memory, generation, model and DeepSeek API settings.",
  "main": "main.js",
  "author": "Novel Studio Pro",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "check": "node --check main.js && node --check preload.js && node --check tools/start_backend.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.novelstudiopro.desktop",
    "productName": "Novel Studio Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "loading.html",
      "src/**/*",
      "tools/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../novel-studio-pro-backend-v1",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!**/*.pyc",
          "!data/**",
          "!frontend_patch/**",
          "!*.md",
          "!*.service",
          "!run_backend.bat"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "./tools/after_pack.js"
  }
}
