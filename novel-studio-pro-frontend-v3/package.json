{
  "name": "novel-studio-pro-frontend-v3",
  "version": "0.3.0",
  "description": "Novel Studio Pro - AI 自动化长篇小说创作工具",
  "main": "main.js",
  "author": "Novel Studio Pro",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder --win",
    "check": "node --check main.js && node --check preload.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.novelstudiopro.desktop",
    "productName": "Novel Studio Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "sign": false,
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Novel Studio Pro"
    }
  }
}
